{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "lcu-companion",
  "version": "0.1.1",
  "identifier": "com.eurmn.lcu-companion",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LCU Companion",
        "width": 1366,
        "height": 850,
        "decorations": false
      },
      {
        "label": "overlay",
        "title": "LCU Companion Overlay",
        "url": "/?window=overlay",
        "width": 1280,
        "height": 720,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzREMwODk1Q0JFODVGOEMKUldTTVgrakxsUWpjODhZV1JUbEFzdnZZeEdrKytpQ1NFZ05UOG1HQ2pSL3hkK1pGUzVDQk1MNEsK",
      "endpoints": [
        "https://github.com/eurmn/lcuc/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
